// LMS Database Schema
// For production, switch provider to "postgresql" and set DATABASE_URL to your Postgres connection string.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // change to "postgresql" for production
  url      = env("DATABASE_URL")
}

// Note: SQLite does not support native enums, so Role is stored as a String.
// Valid values (enforced in application code): "ADMIN" | "TEACHER" | "STUDENT"
// If you switch the datasource provider to "postgresql", you can restore this as
// a real `enum Role { ADMIN TEACHER STUDENT }` and change the field type back to Role.

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password      String   // bcrypt hashed
  role          String
  rollNumber    String?  // students
  department    String?
  phone         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  // Teacher relations
  coursesTaught     Course[]        @relation("TeacherCourses")
  assignmentsMade   Assignment[]    @relation("TeacherAssignments")
  examsMade         Exam[]          @relation("TeacherExams")
  attendanceMarked  Attendance[]    @relation("MarkedBy")

  // Student relations
  enrollments       Enrollment[]
  submissions       Submission[]
  attendanceRecords Attendance[]    @relation("StudentAttendance")
  examAttempts      ExamAttempt[]
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  code        String   @unique
  description String?
  teacherId   Int?
  teacher     User?    @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  enrollments Enrollment[]
  assignments Assignment[]
  attendance  Attendance[]
  exams       Exam[]
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, courseId])
}

model Attendance {
  id         Int      @id @default(autoincrement())
  courseId   Int
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId  Int
  student    User     @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime
  status     String   // PRESENT | ABSENT | LATE
  markedById Int
  markedBy   User     @relation("MarkedBy", fields: [markedById], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId, date])
}

model Assignment {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId   Int
  teacher     User     @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  dueDate     DateTime
  maxMarks    Int      @default(100)
  createdAt   DateTime @default(now())

  submissions Submission[]
}

model Submission {
  id           Int       @id @default(autoincrement())
  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    Int
  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content      String    // text or file URL
  submittedAt  DateTime  @default(now())
  marksObtained Int?
  feedback     String?
  status       String    @default("SUBMITTED") // SUBMITTED | GRADED | LATE

  @@unique([assignmentId, studentId])
}

model Exam {
  id          Int      @id @default(autoincrement())
  title       String
  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId   Int
  teacher     User     @relation("TeacherExams", fields: [teacherId], references: [id], onDelete: Cascade)
  durationMin Int      @default(30)
  startTime   DateTime
  endTime     DateTime
  totalMarks  Int      @default(100)
  createdAt   DateTime @default(now())

  questions Question[]
  attempts  ExamAttempt[]
}

model Question {
  id            Int    @id @default(autoincrement())
  examId        Int
  exam          Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String // A | B | C | D
  marks         Int    @default(1)
}

model ExamAttempt {
  id          Int      @id @default(autoincrement())
  examId      Int
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   Int
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers     String   // JSON string: {questionId: "A"}
  score       Int?
  submittedAt DateTime?
  startedAt   DateTime @default(now())

  @@unique([examId, studentId])
}
